APP_DEBUG=true
API_RATE_LIMIT_ENABLED=true
APP_ENV=local
APP_URL=http://localhost:8787
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3006

# DNMP 容器内使用 mysql/redis；宿主机运行时改为 127.0.0.1。
# 仅填写本机真实配置，禁止提交包含密钥的 .env。
DB_TYPE=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=turtle_soup
DB_USER=turtle_soup
DB_PASSWORD=
DB_PREFIX=
DB_CHARSET=utf8mb4

CACHE_MODE=file
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_DB=1
REDIS_QUEUE_PREFIX=turtle_soup_queue:
REDIS_QUEUE_ENABLED=false
REDIS_QUEUE_CONSUMER_COUNT=1

CAPTCHA_MODE=cache
FRONTEND_DIR=system-manage-ui

COZE_API_BASE_URL=https://api.coze.cn
COZE_API_TOKEN=
COZE_QUESTION_JUDGE_WORKFLOW_ID=
COZE_GUESS_JUDGE_WORKFLOW_ID=
COZE_GAME_DRIVER=mock
ANONYMOUS_TOKEN_TTL_DAYS=30
ANONYMOUS_TOKEN_SECRET=change-me-in-local-env
PLAYER_JWT_SECRET=
PLAYER_TOKEN_HASH_SECRET=
PLAYER_EMAIL_CODE_SECRET=
PLAYER_ACCESS_TOKEN_TTL=900
PLAYER_REFRESH_TOKEN_TTL=2592000
PLAYER_MAX_SESSIONS=3
GAME_WS_LISTEN=websocket://0.0.0.0:8790
ROOM_IDLE_TIMEOUT_SECONDS=1800
ROOM_CLEANUP_INTERVAL_SECONDS=60
COZE_WORKFLOW_ID=
COZE_DRIVER=mock
COZE_TIMEOUT_SECONDS=120
COZE_RETRY_TIMES=1
COZE_RETRY_DELAY_MS=250

MAIL_ENABLED=false
MAIL_TO=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# Baidu Object Storage (BOS) for player avatars
BOS_ACCESS_KEY=
BOS_SECRET_KEY=
BOS_ENDPOINT=https://bj.bcebos.com
BOS_BUCKET=
BOS_PUBLIC_BASE_URL=
SMTP_ENCRYPTION=ssl
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=海龟汤
MAIL_FROM_NAME=海龟汤
